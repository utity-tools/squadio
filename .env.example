# Copy to .env.local and fill in. Validated at startup by src/lib/env/schema.ts:
# a missing or invalid variable stops `next dev` and `next build` with its name.
# Never commit real values; only this file is versioned.

# Public origin of the app: no path, no trailing slash. Inlined into the browser bundle at build time.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only. Connects as the app role (squadio_app), so Row Level Security always applies (ADR 0004).
# This value matches docker-compose.yml: synthetic, local-only credentials.
DATABASE_URL=postgres://squadio_app:squadio_app_dev@127.0.0.1:5434/squadio

# Tooling only: migrations (`pnpm db:migrate`) and database tests (`pnpm test:db`). Connects as the
# owner role, which owns every object; the app never reads it (ADR 0004). Synthetic, local-only.
DATABASE_OWNER_URL=postgres://squadio_owner:squadio_owner_dev@127.0.0.1:5434/squadio

# Sign-in (ADR 0012). Server-only, read on the first request, never at build time.
# Generate each secret with `openssl rand -base64 32`; the two must differ.
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32-output
# Shared by production and the previews only. Whoever holds it can sign in as anyone on a preview,
# never on production, which completes no proxied sign-in.
OAUTH_PROXY_SECRET=replace-with-another-openssl-rand-base64-32
# Unset locally: the app's own origin handles the GitHub and Google callbacks.
# Previews set it to production's origin, which sends them back through the OAuth proxy.
AUTH_PRODUCTION_URL=
# OAuth apps for development, with callbacks on http://localhost:3000/api/auth/callback/<provider>.
GITHUB_CLIENT_ID=replace-with-your-dev-github-client-id
GITHUB_CLIENT_SECRET=replace-with-your-dev-github-client-secret
GOOGLE_CLIENT_ID=replace-with-your-dev-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-your-dev-google-client-secret
# Off unless exactly true. Off, nobody can create an account; production keeps it off until the
# owner's processing review (docs/plan.md, service limits).
SIGN_UP_ENABLED=true
