# Versioned defaults for test runs. Next.js loads this file when NODE_ENV=test and skips .env.local,
# so every machine and CI see the same values. Synthetic only: never put a real secret here.
# Exported variables still win. The credentials match docker-compose.yml (local Postgres only).

NEXT_PUBLIC_APP_URL=http://localhost:3000

# App role: Row Level Security applies (ADR 0004).
DATABASE_URL=postgres://squadio_app:squadio_app_dev@127.0.0.1:5434/squadio_test

# Owner role: migrations and test fixtures only, never the app.
DATABASE_OWNER_URL=postgres://squadio_owner:squadio_owner_dev@127.0.0.1:5434/squadio_test

# Sign-in: synthetic secrets and OAuth clients that no provider knows. Tests never reach GitHub or
# Google. Sign-up stays off here; tests that need it on set it themselves.
BETTER_AUTH_SECRET=synthetic-test-auth-secret-0123456789abcdef
OAUTH_PROXY_SECRET=synthetic-test-proxy-secret-0123456789abcdef
GITHUB_CLIENT_ID=synthetic-test-github-client-id
GITHUB_CLIENT_SECRET=synthetic-test-github-client-secret
GOOGLE_CLIENT_ID=synthetic-test-google-client-id
GOOGLE_CLIENT_SECRET=synthetic-test-google-client-secret
